# Copy this file to .env (Git ignores .env) and fill in your own local values.
# Never put real values in this file: it is committed to GitHub.
# SQL Server needs at least 8 characters with upper case, lower case and digits.
# Use only letters and digits, so the values pass safely through the scripts.
MSSQL_SA_PASSWORD=
CUSTOMERS_DB_PASSWORD=
LESSONS_DB_PASSWORD=
# Shared by both services: the customers service signs login tokens with it,
# the lessons service checks them with it. Any long random text.
AUTH_SECRET=
# Password of the staff account "admin" in the UI.
ADMIN_PASSWORD=
